# ---------------------------------------------------------------------------
# Fluxer instance + application
# Create the application on your instance: User Settings -> Applications
# ---------------------------------------------------------------------------
FLUXER_INSTANCE_ORIGIN=https://fluxer.example.com
FLUXER_APP_ID=
FLUXER_CLIENT_SECRET=
FLUXER_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Dashboard
# DASHBOARD_ORIGIN must match the redirect URI registered on the application:
#   {DASHBOARD_ORIGIN}/auth/callback
# ---------------------------------------------------------------------------
DASHBOARD_ORIGIN=http://localhost:3000

# Generate with: openssl rand -base64 32
SESSION_SECRET=
ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (Postgres)
# Docker Compose overrides this with the `postgres` service hostname.
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://fluxbot:${DATABASE_PASSWORD}@localhost:5432/fluxbot

# Used by docker-compose.yml only.
POSTGRES_PASSWORD=change-me
WEB_PORT=3000

# ---------------------------------------------------------------------------
# Bot
# ---------------------------------------------------------------------------
# Comma-separated Fluxer user IDs allowed to run operator commands.
BOT_OPERATOR_IDS=
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Legal pages (/privacy and /terms)
# Set these to the person or team operating this deployment.
# ---------------------------------------------------------------------------
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_SUPPORT_URL=

# Seed a fake instance/user/guild so the dashboard renders without Fluxer.
# Evaluation only: anyone who can reach the dashboard can sign in as the demo
# admin while this is enabled.
DEMO_MODE=false